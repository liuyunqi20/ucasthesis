<mxfile host="app.diagrams.net" modified="2026-06-23T00:00:00.000Z" agent="Codex" version="24.7.17">
  <diagram id="research-contents" name="主要研究内容关系图">
    <mxGraphModel dx="1180" dy="760" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="面向 NPU Triton 后端的算子生成与协同优化研究内容" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="120" y="40" width="960" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="input" value="输入与先验&#xa;PyTorch 参考实现 / 算子描述&#xa;输入形状、数据类型、误差范围&#xa;目标 NPU 硬件配置&#xa;手写高性能算子与失败案例知识库" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F9FAFB;strokeColor=#9CA3AF;fontSize=14;fontColor=#111827;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="165" width="230" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="part1" value="研究内容一&#xa;KernelPlan 约束的智能体生成&#xa;&#xa;解析算子语义，形成中间规划表示&#xa;描述索引关系、并行/归约维度、分块层次、边界处理和数据复用&#xa;生成 Triton 候选程序、调度配置与 Pass 建议" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DBEAFE;strokeColor=#2563EB;fontSize=14;fontColor=#111827;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="360" y="130" width="250" height="230" as="geometry"/>
        </mxCell>
        <mxCell id="part2" value="研究内容二&#xa;NPU 后端反馈映射机制&#xa;&#xa;导出后端 IR、Pass 诊断、资源统计和性能模型结果&#xa;识别片上存储、DMA、通信重叠、处理单元利用率和布局低效等瓶颈&#xa;建立“诊断信息 - 性能瓶颈 - 优化动作”的映射" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=14;fontColor=#111827;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="760" y="130" width="300" height="230" as="geometry"/>
        </mxCell>
        <mxCell id="part3" value="研究内容三&#xa;联合搜索与经验反哺&#xa;&#xa;围绕代码形态、块大小、流水级数、数据布局、片上存储分配和 Pass 序列进行分层联合调优&#xa;沉淀优化轨迹，形成可检索、可验证、可复用经验&#xa;反哺智能体生成、Pass 选择、代价模型和局部优化规则" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=14;fontColor=#111827;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="420" y="480" width="360" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="output" value="预期输出&#xa;正确且高性能的 Triton 算子&#xa;可复现测试集与优化轨迹数据&#xa;面向 NPU 后端的协同优化原型" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F3F4F6;strokeColor=#6B7280;fontSize=14;fontColor=#111827;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="900" y="500" width="230" height="145" as="geometry"/>
        </mxCell>
        <mxCell id="e-input-p1" value="算子语义与历史先验" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4B5563;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#374151;" edge="1" parent="1" source="input" target="part1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-p1-p2" value="候选 Triton 程序&#xa;调度配置 / Pass 建议" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#1D4ED8;" edge="1" parent="1" source="part1" target="part2">
          <mxGeometry relative="1" as="geometry"/>
