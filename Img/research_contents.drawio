        <mxCell id="e-p3-output" value="验证后的优化结果" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4B5563;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#374151;" edge="1" parent="1" source="part3" target="output">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="note" value="核心关系：生成候选 → 后端诊断 → 联合调优 → 经验沉淀 → 反哺生成与编译器" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#D1D5DB;fontSize=15;fontStyle=1;fontColor=#374151;spacing=10;" vertex="1" parent="1">
