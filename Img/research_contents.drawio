        <mxCell id="e-p3-p2" value="Pass 选择先验&#xa;代价模型校准&#xa;局部优化规则" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#D97706;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontSize=12;fontColor=#B45309;" edge="1" parent="1" source="part3" target="part2">
          <mxGeometry relative="1" as="geometry">
