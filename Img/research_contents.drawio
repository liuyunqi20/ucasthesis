        <mxCell id="e-p2-p3" value="IR、诊断、资源与性能反馈" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16A34A;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#15803D;" edge="1" parent="1" source="part2" target="part3">
