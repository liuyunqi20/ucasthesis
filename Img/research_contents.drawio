        <mxCell id="e-p3-p1" value="修复策略、调度先验、失败案例" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#D97706;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#B45309;" edge="1" parent="1" source="part3" target="part1">
